ARG BASE_IMAGE=automap-converter:runtime
FROM ${BASE_IMAGE}
USER root
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY . /workspace
RUN pip install --no-cache-dir '.[service]' \
    && useradd --uid 10001 --create-home automap \
    && mkdir -p /var/lib/automap \
    && chown -R automap:automap /var/lib/automap /workspace
USER automap
ENV AUTOMAP_DATA_DIR=/var/lib/automap
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready',timeout=3)" || exit 1
CMD ["uvicorn", "automap_service.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
