 <node id="11539091830" visible="true" version="1" changeset="146536445" timestamp="2024-01-22T04:52:32Z" user="❤️‍🔥" uid="10140394" lat="-33.8674358" lon="151.2121799">
  <tag k="end_date" v="1933"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="The house once on this site was built in 1841 for ironmonger and landlord Thomas Burdekin. By the 1890s it had become a celebrated political salon. It was demolished in 1933. This plaque is sponsored by Caltex."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Burdekin House"/>
  <tag k="name:etymology" v="Thomas Burdekin"/>
  <tag k="start_date" v="1841"/>
 </node>
 <node id="11539091831" visible="true" version="1" changeset="146536445" timestamp="2024-01-22T04:52:32Z" user="❤️‍🔥" uid="10140394" lat="-33.8665233" lon="151.2125749">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="The colony was short of servants. In this school, originally a light-horse barracks, the ladies of Sydney sought to teach their lesser sisters &quot;every branch of household work&quot;. The site is now occupied by the Mitchell Library. Sponsored by Caltex."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Female School of Industry"/>
 </node>
