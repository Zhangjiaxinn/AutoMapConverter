  <tag k="duration" v="60"/>
  <tag k="interval" v="5"/>
  <tag k="interval:conditional" v="4 @(Sa-Su)"/>
  <tag k="name" v="東京地下鉄の直通運転 - 東横線"/>
  <tag k="name:en" v="Tokyo Metro - Toyoko bypass line"/>
  <tag k="name:es" v="Tokyo Metro - Línea baipás Toyoko"/>
  <tag k="name:ja" v="東京地下鉄の直通運転 - 東横線"/>
  <tag k="name:ja-Latn" v="Tōkyō chikatetsu no chokutsū unten - Tōyokosen"/>
  <tag k="name:ru" v="Прямая эксплуатация токийского метро - Линия Тоёко"/>
  <tag k="network" v="東急電鉄"/>
  <tag k="network:metro" v="東京メトロ直通運転"/>
  <tag k="network:note" v="Tokyo Metro commuter service through third railways lines. Trains cross Tokyo metropolitan area without having to change trains. In japanese is called 直通運転 (direct operation)."/>
  <tag k="note" v="Suburban rail operated in conjunction between Tokyo Metro, Yokohama Minatomirai and Tokyu Corporation"/>
  <tag k="opening_hours" v="Mo-Su 05:30-23:00"/>
  <tag k="operator" v="東急電鉄;東京地下鉄"/>
  <tag k="operator:en" v="Tokyu Corporation;Tokyo Metro"/>
  <tag k="passenger" v="suburban"/>
  <tag k="ref" v="DT"/>
  <tag k="route_master" v="train"/>
  <tag k="source:description" v="https://ja.m.wikipedia.org/wiki/東京メトロ半蔵門線#東急田園都市線直通;http://www.ejrcf.or.jp/jrtr/jrtr63/pdf/6-13_web.pdf"/>
  <tag k="source:network" v="https://www.tokyometro.jp/support/startguide/pdf/startguide_03.pdf;https://www.tokyometro.jp/news/images_h/20150617metroNews_g18n91.pdf;https://en.wikipedia.org/wiki/List_of_through_trains_in_Japan"/>
  <tag k="source:note" v="https://metroarchive.jp/content/ebook_hanzomon.html/"/>
